// Esquema de datos de la tienda virtual de Cafetería APU (prototipo académico).
// Montos en céntimos de sol (Int) para evitar errores de redondeo.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Usuarios y privacidad ───────────────────────────

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum DocType {
  DNI
  CE
  PASAPORTE
  RUC
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  passwordHash         String
  fullName             String
  phone                String?
  docType              DocType?
  docNumber            String?
  role                 Role      @default(CUSTOMER)
  privacyAcceptedAt    DateTime
  privacyPolicyVersion String
  marketingConsent     Boolean   @default(false)
  marketingConsentAt   DateTime?
  anonymizedAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  addresses     Address[]
  carts         Cart[]
  orders        Order[]
  reviews       Review[]
  returns       ReturnRequest[]
  auditLogs     AuditLog[]
  statusChanges OrderStatusHistory[]
  movements     InventoryMovement[]
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  label      String
  recipient  String
  phone      String
  line1      String
  reference  String?
  district   String
  province   String
  department String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────── Catálogo ───────────────────────────────

/// CAFETERIA: preparado en el local (perecible, solo Jaén).
/// EMPACADO: café APU y artículos con envío nacional.
enum ProductLine {
  CAFETERIA
  EMPACADO
}

model Category {
  id          String      @id @default(uuid())
  slug        String      @unique
  name        String
  description String?
  line        ProductLine
  sortOrder   Int         @default(0)

  products Product[]
}

model Product {
  id          String      @id @default(uuid())
  slug        String      @unique
  name        String
  shortDescription String
  description String
  line        ProductLine
  categoryId  String
  imageUrl    String?
  tags        String[]
  /// Ficha técnica: variedad, altitud, notas, certificaciones, etc.
  attributes  Json?
  perishable  Boolean     @default(true)
  isActive    Boolean     @default(true)
  isFeatured  Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  category  Category         @relation(fields: [categoryId], references: [id])
  variants  ProductVariant[]
  reviews   Review[]
  coupons   Coupon[]

  @@index([categoryId])
  @@index([line, isActive])
}

model ProductVariant {
  id         String   @id @default(uuid())
  productId  String
  sku        String   @unique
  name       String
  priceCents Int
  /// false = se prepara al momento (bebidas): no se descuenta stock.
  trackStock Boolean  @default(true)
  stock      Int      @default(0)
  /// Si tiene valor, el stock se repone a esta cantidad cada día (postres).
  dailyStock Int?
  lowStockThreshold Int @default(5)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]
  movements  InventoryMovement[]

  @@index([productId])
}

// ─────────────────────────────── Inventario ───────────────────────────────

enum MovementType {
  INITIAL
  RESTOCK
  SALE
  RELEASE
  ADJUSTMENT
  DAILY_RESET
  RETURN
}

model InventoryMovement {
  id        String       @id @default(uuid())
  variantId String
  type      MovementType
  /// Positivo = entra stock; negativo = sale stock.
  quantity  Int
  stockAfter Int
  reason    String?
  orderId   String?
  userId    String?
  createdAt DateTime     @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  order   Order?         @relation(fields: [orderId], references: [id])
  user    User?          @relation(fields: [userId], references: [id])

  @@index([variantId, createdAt])
}

// ─────────────────────────────── Carrito ───────────────────────────────

model Cart {
  id        String   @id @default(uuid())
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items CartItem[]

  @@index([userId])
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  variantId String
  quantity  Int
  addedAt   DateTime @default(now())

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

// ─────────────────────────────── Cupones ───────────────────────────────

enum CouponType {
  /// value = porcentaje (1-100)
  PERCENT
  /// value = céntimos
  FIXED
  /// Lleva buyQty + getQty y paga buyQty (ej. 2x1 => buy 1, get 1)
  BUY_X_GET_Y
  /// Una unidad gratis del producto indicado
  FREE_ITEM
}

model Coupon {
  id               String     @id @default(uuid())
  code             String     @unique
  description      String
  type             CouponType
  value            Int        @default(0)
  buyQty           Int?
  getQty           Int?
  productId        String?
  minSubtotalCents Int?
  startsAt         DateTime?
  endsAt           DateTime?
  /// Franja horaria (hora de Lima, 0-23). Ej. 15 a 19 = de 3:00 p. m. a 6:59 p. m.
  hourFrom         Int?
  hourTo           Int?
  maxUses          Int?
  usedCount        Int        @default(0)
  perCustomerLimit Int?
  requiresLogin    Boolean    @default(false)
  /// Canal de marketing que originó el cupón (contenidos, influencer, email...)
  channel          String
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())

  product     Product?           @relation(fields: [productId], references: [id])
  redemptions CouponRedemption[]
}

model CouponRedemption {
  id            String   @id @default(uuid())
  couponId      String
  orderId       String   @unique
  customerEmail String
  userId        String?
  discountCents Int
  createdAt     DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, customerEmail])
}

// ─────────────────────────────── Pedidos ───────────────────────────────

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ShippingMethod {
  PICKUP
  DELIVERY_LOCAL
  NATIONAL
}

enum PaymentMethod {
  CARD
  YAPE
  PLIN
  CASH_ON_DELIVERY
  PAY_AT_STORE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ReceiptType {
  BOLETA
  FACTURA
}

model Order {
  id                String         @id @default(uuid())
  code              String         @unique
  userId            String?
  customerName      String
  customerEmail     String
  customerPhone     String
  customerDocType   DocType
  customerDocNumber String
  status            OrderStatus
  shippingMethod    ShippingMethod
  shippingAddress   Json?
  carrier           String?
  trackingNumber    String?
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus  @default(PENDING)
  receiptType       ReceiptType    @default(BOLETA)
  receiptNumber     String?        @unique
  businessName      String?
  subtotalCents     Int
  discountCents     Int            @default(0)
  shippingCents     Int            @default(0)
  totalCents        Int
  refundedCents     Int            @default(0)
  couponCode        String?
  notes             String?
  /// ¿Cómo nos conociste? (atribución del plan de marketing)
  source            String?
  marketingConsent  Boolean        @default(false)
  /// Hash del token que permite a un invitado consultar y pagar su pedido.
  guestTokenHash    String?
  expiresAt         DateTime?
  paidAt            DateTime?
  deliveredAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user       User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  items      OrderItem[]
  payments   Payment[]
  history    OrderStatusHistory[]
  redemption CouponRedemption?
  movements  InventoryMovement[]
  returns    ReturnRequest[]
  reviews    Review[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([customerEmail])
}

model OrderItem {
  id             String      @id @default(uuid())
  orderId        String
  variantId      String
  productId      String
  productName    String
  variantName    String
  sku            String
  line           ProductLine
  perishable     Boolean
  unitPriceCents Int
  quantity       Int
  lineTotalCents Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

model OrderStatusHistory {
  id          String       @id @default(uuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  changedById String?
  createdAt   DateTime     @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id])

  @@index([orderId, createdAt])
}

// ─────────────────────────────── Pagos (simulados) ───────────────────────────────

enum PaymentAttemptStatus {
  PENDING
  APPROVED
  DECLINED
  REFUNDED
  CANCELLED
}

model Payment {
  id             String               @id @default(uuid())
  orderId        String
  method         PaymentMethod
  status         PaymentAttemptStatus
  amountCents    Int
  refundedCents  Int                  @default(0)
  provider       String               @default("SIMULADOR-APU")
  providerRef    String               @unique
  /// Nunca se guarda el número completo ni el CVV: solo marca y últimos 4 dígitos.
  cardBrand      String?
  cardLast4      String?
  walletPhoneMasked String?
  failureCode    String?
  failureMessage String?
  idempotencyKey String?              @unique
  createdAt      DateTime             @default(now())
  processedAt    DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ─────────────────────────────── Posventa ───────────────────────────────

enum ReturnType {
  REPLACEMENT
  REFUND
}

enum ReturnStatus {
  OPEN
  APPROVED
  REJECTED
  COMPLETED
}

model ReturnRequest {
  id           String       @id @default(uuid())
  code         String       @unique
  orderId      String
  userId       String?
  type         ReturnType
  reason       String
  description  String
  /// [{ orderItemId, quantity }]
  items        Json
  productSealed Boolean     @default(false)
  status       ReturnStatus @default(OPEN)
  resolution   String?
  refundCents  Int          @default(0)
  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Review {
  id          String   @id @default(uuid())
  orderId     String
  productId   String
  userId      String?
  authorName  String
  rating      Int
  comment     String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([orderId, productId])
  @@index([productId, isPublished])
}

// ─────────────────────── Libro de Reclamaciones virtual ───────────────────────

enum ComplaintType {
  /// Disconformidad con el producto o servicio
  RECLAMO
  /// Malestar con la atención, sin relación directa con el producto
  QUEJA
}

enum ComplaintStatus {
  RECEIVED
  IN_PROGRESS
  ANSWERED
}

model Complaint {
  id              String          @id @default(uuid())
  code            String          @unique
  type            ComplaintType
  consumerName    String
  docType         DocType
  docNumber       String
  email           String
  phone           String
  address         String
  isMinor         Boolean         @default(false)
  guardianName    String?
  goodType        String
  goodDescription String
  amountCents     Int?
  orderCode       String?
  detail          String
  consumerRequest String
  status          ComplaintStatus @default(RECEIVED)
  response        String?
  respondedAt     DateTime?
  dueAt           DateTime
  createdAt       DateTime        @default(now())

  @@index([status, createdAt])
}

// ─────────────────────────────── B2B ───────────────────────────────

enum QuoteStatus {
  NEW
  QUOTED
  ACCEPTED
  REJECTED
}

model CorporateQuote {
  id                String      @id @default(uuid())
  code              String      @unique
  companyName       String
  ruc               String
  contactName       String
  email             String
  phone             String
  requestType       String
  /// [{ description, quantity }]
  items             Json
  eventDate         DateTime?
  deliveryAddress   String?
  notes             String?
  status            QuoteStatus @default(NEW)
  quotedAmountCents Int?
  adminNotes        String?
  validUntil        DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status, createdAt])
}

// ─────────────────────────────── Soporte ───────────────────────────────

/// Contadores correlativos (pedidos, boletas, facturas, reclamos...).
model Counter {
  name  String @id
  value Int    @default(0)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  data      Json?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}
