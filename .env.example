# Copia este archivo como .env y ajusta los valores.
# Valores de DEMOSTRACIÓN para ejecutar el prototipo en local.

# ── Base de datos (PostgreSQL en Docker)
POSTGRES_DB=apu_tienda
POSTGRES_USER=apu
POSTGRES_PASSWORD=apu_local_dev
DB_PORT=5433

# ── API
API_PORT=4000
# Genera uno propio, por ejemplo: openssl rand -hex 32
JWT_SECRET=cambia-este-secreto-por-uno-aleatorio-de-64-caracteres
JWT_EXPIRES_IN=12h
# Puerto local de la tienda web
WEB_PORT=8080
# Orígenes permitidos (frontend). Los túneles *.trycloudflare.com se aceptan automáticamente.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
PAYMENT_WINDOW_MINUTES=15
# true = solo acepta pedidos de cafetería dentro del horario de atención
ENFORCE_STORE_HOURS=false
LOG_LEVEL=info

# ── Datos iniciales
SEED_ON_START=true
# Cuenta de administración de prueba (se crea solo si no existe)
ADMIN_EMAIL=admin@apu-demo.test
ADMIN_PASSWORD=ApuAdmin2026
